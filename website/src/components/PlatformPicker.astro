---
import CopyRow from "./CopyRow.astro";
import { ARCHIVES, DOWNLOADS } from "../consts";

/**
 * Was the homepage download section. It lives on /download/ now: the homepage
 * sends people here rather than half-answering the question itself.
 *
 * Archives are version-stamped, so the real filenames come from consts.ts and a
 * release bump is one edit there instead of a sweep through this markup.
 */
const PLATFORMS = [
    {
        id: "windows",
        name: "Windows",
        /**
         * Single path each, on a 24x24 grid. Filled with currentColor so the mark
         * tracks the card's text colour instead of carrying its own.
         */
        mark: "M2.75 7.189V2.865c0-.102 0-.115.115-.115h8.622c.128 0 .14 0 .14.128V11.5c0 .128 0 .128-.14.128H2.865c-.102 0-.115 0-.115-.116zM7.189 21.25H2.865c-.102 0-.115 0-.115-.116V12.59c0-.128 0-.128.128-.128h8.635c.102 0 .115 0 .115.115v8.57c0 .09 0 .103-.116.103zM21.25 7.189v4.31c0 .116 0 .116-.116.116h-8.557c-.102 0-.128 0-.128-.115V2.865c0-.09 0-.102.115-.102h8.48c.206 0 .206 0 .206.205zm-8.763 9.661v-4.273c0-.09 0-.115.103-.09h8.621c.026 0 0 .09 0 .142v8.518a.06.06 0 0 1-.017.06a.06.06 0 0 1-.06.017H12.54s-.09 0-.077-.09V16.85z",
        requirement: "Windows 10 or 11, x86_64",
        archive: ARCHIVES.windows,
        href: DOWNLOADS.windows,
        /** Verification command from the project README. */
        verify: `(Get-FileHash .\\${ARCHIVES.windows} -Algorithm SHA256).Hash.ToLower()`,
        shell: "PowerShell",
    },
    {
        id: "macos",
        name: "macOS",
        mark: "M17.05 20.28c-.98.95-2.05.8-3.08.35c-1.09-.46-2.09-.48-3.24 0c-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8c1.18-.24 2.31-.93 3.57-.84c1.51.12 2.65.72 3.4 1.8c-3.12 1.87-2.38 5.98.48 7.13c-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25c.29 2.58-2.34 4.5-3.74 4.25",
        requirement: "Apple Silicon only - Intel is unsupported",
        archive: ARCHIVES.macos,
        href: DOWNLOADS.macos,
        verify: `shasum -a 256 ${ARCHIVES.macos}`,
        shell: "Terminal",
    },
];
---

<section id="download" class="border-b border-rule py-[clamp(48px,6vw,72px)]">
    <div class="container-page">
        <div
            class="grid gap-px overflow-hidden border border-rule bg-rule lg:grid-cols-2"
        >
            {
                PLATFORMS.map((platform) => (
                    <article
                        class="platform flex min-w-0 flex-col gap-6 bg-blue p-[clamp(22px,3vw,32px)]"
                        data-platform={platform.id}
                    >
                        <div class="flex items-baseline justify-between gap-4">
                            <h2 class="display flex items-center gap-[0.42em] text-[clamp(1.9rem,3.2vw,2.6rem)]">
                                <svg
                                    class="size-[0.86em] shrink-0 text-mist"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path
                                        fill="currentColor"
                                        d={platform.mark}
                                    />
                                </svg>
                                {platform.name}
                            </h2>
                            <span class="badge tag shrink-0" hidden>
                                Your system
                            </span>
                        </div>

                        <p class="text-[0.92rem] leading-[1.6] text-mist-70">
                            {platform.requirement}
                        </p>

                        <CopyRow label="Archive" value={platform.archive} />

                        <CopyRow
                            label={`Verify in ${platform.shell}`}
                            value={platform.verify}
                            muted
                        />

                        <a
                            href={platform.href}
                            class="mt-auto inline-flex h-[46px] items-center justify-center gap-[9px] rounded-[3px] border border-paper bg-paper px-5 font-mono text-[0.8rem] font-medium text-blue-ink transition-colors hover:border-mist hover:bg-mist"
                        >
                            Download for {platform.name}
                            <svg
                                class="size-[13px]"
                                viewBox="0 0 16 16"
                                aria-hidden="true"
                            >
                                <path
                                    fill="currentColor"
                                    d="M8 1.5a.6.6 0 0 1 .6.6v8.05l2.83-2.83a.6.6 0 1 1 .85.85l-3.86 3.86a.6.6 0 0 1-.85 0L3.71 8.17a.6.6 0 1 1 .85-.85L7.4 10.15V2.1a.6.6 0 0 1 .6-.6M2.6 13.3h10.8a.6.6 0 1 1 0 1.2H2.6a.6.6 0 1 1 0-1.2"
                                />
                            </svg>
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<script>
    // Flag the card matching the visitor's platform. Both cards stay fully
    // usable; this is a hint, not a filter, so a wrong guess costs nothing.
    const platform = (
        (navigator as any).userAgentData?.platform ||
        navigator.platform ||
        ""
    ).toLowerCase();
    const ua = navigator.userAgent.toLowerCase();
    const touch = navigator.maxTouchPoints > 1;

    let id = "";
    if (platform.includes("win")) id = "windows";
    else if ((platform.includes("mac") || ua.includes("macintosh")) && !touch)
        id = "macos";

    if (id) {
        const card = document.querySelector(`.platform[data-platform="${id}"]`);
        card?.classList.add("is-current");
        card?.querySelector(".badge")?.removeAttribute("hidden");
    }
</script>

<style>
    .platform.is-current {
        background: color-mix(
            in srgb,
            var(--color-paper) 6%,
            var(--color-blue)
        );
    }
</style>
